							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Relocating/changing the place of manufacture is not permissible, in particular not after build sample approval has been issued.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
