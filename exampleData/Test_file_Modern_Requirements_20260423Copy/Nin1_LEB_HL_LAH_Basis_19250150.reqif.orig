				<SPEC-OBJECT IDENTIFIER="_0a7a376d-566d-4d9d-bb96-2e5c1abac47e" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>Die Verwendung des D-Muster Standes dient als Grundlage zum Nachweis der Fertigungssicherheit f&#xFC;r die Serienlieferung an Hand der Ausr&#xFC;stung von Vorserien und Fahrgro&#xDF;versuchen (Breitenerprobung).</reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_aaa1ba64-f928-4220-80d4-9801308ea8ff</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250374">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>The D-sample version is used as a basis to verify manufacturing reliability for the production supply by using it as equipment in pre-production and large-scale road testing (extended testing program).</reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_905af2ef-6221-47c9-9682-9f0fd946698a" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>Der Auftragnehmer muss f&#xFC;r D-Muster die Anforderungen zur Belastungskriterien, Restriktionen, Qualit&#xE4;t und Fahrtauglichkeit unter den Betriebsbedingungen gleichbleibend sicherstellen.</reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_ded8839a-d6a6-4f3f-954d-b0ccc627fc45</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250375">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>For D-samples, the contractor shall ensure that the requirements regarding load criteria, restrictions, quality, and roadworthiness are met consistently under the operating conditions.</reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
