						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:h3>Sample versions and numbers of samples</reqif-xhtml:h3></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
