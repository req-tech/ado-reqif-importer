							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p style="margin-left:0px;">Der Auftragnehmer muss ein Erprobungskonzept anhand des Dokuments &quot;LAH.DUM.000.CK Lieferantenselbstauskunft Komponentenerprobung&quot; mit den Angebotsunterlagen an den Auftraggeber &#xFC;bergeben.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_ded8839a-d6a6-4f3f-954d-b0ccc627fc45</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
