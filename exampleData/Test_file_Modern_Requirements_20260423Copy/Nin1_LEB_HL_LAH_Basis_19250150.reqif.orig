							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The Supplier Guide is included in the RFQ package from Procurement and is available to download as a PDF document from the ONE.Group Business Platform (formerly B2B supplier platform).</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
