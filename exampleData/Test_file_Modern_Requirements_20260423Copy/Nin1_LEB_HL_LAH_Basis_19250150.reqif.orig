				<SPEC-OBJECT IDENTIFIER="_2fb38fc4-f9ab-49f7-9d81-bf9ab78535a5" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Der Auftragnehmer muss die geplante Reihenfolge und Ausrichtung der Teile beim Verbau sowie der zu verwendenden Vorrichtungen in allen 6 Freiheitsgraden beschreiben.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_ded8839a-d6a6-4f3f-954d-b0ccc627fc45</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250624">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The contractor must describe the intended sequence and alignment of the parts during installation, as well as the fixtures to be used, in all 6&#xA0;degrees of freedom.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_7047b729-df5a-4506-9d29-7b7f46ce9ba3" LAST-CHANGE="2025-12-09T21:06:29">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_9d36d841-9775-43a3-bccd-8d7369d7fe17</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>Geometrie</reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_f47ace98-290f-4967-9abb-39806afe51e8</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250625">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:b>Geometry&#xA0;</reqif-xhtml:b></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_9e4b62a4-e1bd-4156-b6ff-b521cac46847" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>In diesem Kapitel sollen vom Auftraggeber Festlegungen bez&#xFC;glich der Geometrie, Abmessungen, des Platzbedarfs und des Packagings definiert werden. Die &#xE4;u&#xDF;ere Bauform der Komponente ist mit der einbauenden Fachabteilung abzustimmen.<reqif-xhtml:br/>Informationen:&#xA0;<reqif-xhtml:a href="https://iproject.vw.vwg/iproject/vw/index.htm#/C0AB88610018CA735CB87EDFD18CA735">EGN/G Geometrische Absicherung &amp; Freigabe (vw.vwg)</reqif-xhtml:a></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_aaa1ba64-f928-4220-80d4-9801308ea8ff</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250627">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>In this section, please define the specifications for geometry, dimensions, required space, and packaging. The component&#039;s exterior design must be agreed upon with the installing department.<reqif-xhtml:br/>Information:&#xA0;<reqif-xhtml:span style="text-decoration:underline;">EGN/G Geometric validation &amp; release (vw.vwg)</reqif-xhtml:span></reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_eeded008-64cd-4a3e-8f11-59b553793aa6" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>Der Auftragnehmer muss die &#xE4;u&#xDF;ere Geometrie der Baugruppe und insbesondere die Lage und Ausf&#xFC;hrung der Befestigungspunkte (falls vorhanden) mit den zust&#xE4;ndigen Fachabteilungen des Auftraggebers, unter Zugrundelegung des vom Auftraggeber definierten Bauraumes, abstimmen.<reqif-xhtml:b/></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_ded8839a-d6a6-4f3f-954d-b0ccc627fc45</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250629">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The contractor must agree upon the external geometry of the component and, in particular, the position and design of the fastening points (if present) with the purchaser&#039;s appropriate departments, using the packaging space defined by the purchaser as a basis.</reqif-xhtml:p><reqif-xhtml:p><reqif-xhtml:br/></reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_2fafbf46-df2e-4375-ab9b-887962295ed1" LAST-CHANGE="2025-12-17T23:37:24">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_9d36d841-9775-43a3-bccd-8d7369d7fe17</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Die Bema&#xDF;ungen sowohl des Applikationschips sowie des Referenzchips befinden sich im Abschnitt &quot;Anforderungen an Chip Design&quot;</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_f47ace98-290f-4967-9abb-39806afe51e8</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="24647247">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The outer dimensions of both the application and reference type chip can be found in Chapter &quot;Requirements on Chip Design&quot;</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_d66b99d2-3f0d-4179-9f10-ed9c87c9cf99" LAST-CHANGE="2025-12-09T21:08:15">
