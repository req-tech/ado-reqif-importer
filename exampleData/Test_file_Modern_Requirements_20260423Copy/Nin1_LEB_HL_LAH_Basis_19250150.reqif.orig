							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>Nachfolgend werden diese Abk&#xFC;rzungen verwendet:&#xA0;<reqif-xhtml:ul><reqif-xhtml:li>Polyamid (PA)</reqif-xhtml:li><reqif-xhtml:li>Polybutylenterephthalat&#xA0;&#xA0;(PBT)</reqif-xhtml:li><reqif-xhtml:li>Polyoxymethylen (POM)</reqif-xhtml:li><reqif-xhtml:li>Polycarbonat + Acrylnitril Butadien Styrol (PC+ABS)</reqif-xhtml:li></reqif-xhtml:ul></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_aaa1ba64-f928-4220-80d4-9801308ea8ff</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250644">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The following abbreviations are used below:&#xA0;</reqif-xhtml:p><reqif-xhtml:ul><reqif-xhtml:li>Polyamide (PA)</reqif-xhtml:li><reqif-xhtml:li>Polybutylene terephthalate (PBT)</reqif-xhtml:li><reqif-xhtml:li>Polyoxymethylene (POM)</reqif-xhtml:li><reqif-xhtml:li>Polycarbonate + acrylonitrile butadiene styrene (PC+ABS)</reqif-xhtml:li></reqif-xhtml:ul></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
