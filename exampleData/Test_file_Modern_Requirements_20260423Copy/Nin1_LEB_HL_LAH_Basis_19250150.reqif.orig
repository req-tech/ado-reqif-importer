					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Falls es sich bei einem Bauteil um eine elektrische Komponente handelt, m&#xFC;ssen Bauteileigenschaften wie die elektrische Leitf&#xE4;higkeit, magnetische Permeabilit&#xE4;t oder die relative Permittivit&#xE4;t bereitgestellt werden.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_ded8839a-d6a6-4f3f-954d-b0ccc627fc45</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250926">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>For electrical components the compoment properties such as electrical conductivity, magnetic permeability or relative permeability shall be provided.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
