						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250229">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div>In the event of a supplier evaluation commissioned by the purchaser, the contractor shall provide all the documents specified in the scope of quotation as well as a supplier self-registration (SSR) to the third parties commissioned with the evaluation.</reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
