						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>If the contractor is to handle information classified as &quot;confidential&quot; or &quot;secret,&quot; the contractor must submit proof of the corresponding data protection as per VDA ISA (Information Security Assessment) in the form of a corresponding TISAX certificate (Trusted Information Security Assessment Exchange) to the purchaser.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_e1a57b6d-3cd8-49ea-a641-17e03882d5bb" LAST-CHANGE="2025-05-15T15:04:28">
