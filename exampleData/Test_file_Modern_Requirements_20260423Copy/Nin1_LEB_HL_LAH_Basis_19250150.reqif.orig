				<SPEC-OBJECT IDENTIFIER="_f66f58b1-436d-47e5-bf7c-5b1784f2f967" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Die vom Auftragnehmer zu erf&#xFC;llenden Anforderungen sind im Attribut &quot;Kategorie&quot; grunds&#xE4;tzlich mit dem Eintrag &quot;funktionale Anforderung&quot; oder &quot;nicht-funktionale Anforderung&quot; gekennzeichnet. Elemente mit dem Eintrag &quot;Information&quot;, sind Informationen zum besseren Verst&#xE4;ndnis des BT-LAH. Gibt es keinen Eintrag im Attribut &quot;Kategorie&quot;, handelt es sich ebenfalls um eine Anforderung.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_aaa1ba64-f928-4220-80d4-9801308ea8ff</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250159">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Elements, marked with &quot;Funktionale Anforderung&quot; or &quot;Nicht-funktionale Anforderung&quot; in the attribute &quot;Kategorie&quot;, are requirements the contractor must fulfill. Elements marked with &quot;Information&quot; contain information about the Performance Specification. If the attribute &quot;Kategorie&quot; is not filled, then this element is also a requirement.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
