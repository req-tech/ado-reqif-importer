				<SPEC-OBJECT IDENTIFIER="_09ba1383-7e80-4bf2-a413-879713dc4a74" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>F&#xFC;r verwendete, metallische Werkstoffe sollten im Temperaturbereich von -50&#xB0;C bis 150&#xB0;C statische Spannungs-Dehnungs-Kurven bis zum Versagen bereit gestellt werden.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_ded8839a-d6a6-4f3f-954d-b0ccc627fc45</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250878">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Static stress-strain curves until failure should be provided for all metal materials to be used. These curves should cover a temperature range from -50&#xB0;C up to 150&#xB0;C.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_95eba387-f6d8-44e0-b245-2c7c832c2cee" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>F&#xFC;r verwendete, metallische Werkstoffe sollten im Temperaturbereich von -50&#xB0;C bis 150&#xB0;C W&#xF6;hlerkurven mit verschiedenen Mittelspannungsanteilen bereit gestellt werden.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
