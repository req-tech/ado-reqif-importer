							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The contractor must carry out the material sample inspection as per VW&#xA0;52000.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
