				<SPEC-OBJECT IDENTIFIER="_2046b13e-b58e-4835-b06f-3974c3faa9e1" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Der Auftragnehmer muss zu jeder Lieferung eines neuen Standes der Komponente (Hardware, Software und/oder Mechanik) eine Mustermappe an den Auftraggeber &#xFC;bergeben.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_ded8839a-d6a6-4f3f-954d-b0ccc627fc45</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250554">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>With every delivery of a new component version (hardware, software, and/or mechanical components), the contractor must provide the purchaser with sample documentation.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_389b44a0-9fa2-44f5-aee2-a9287fac60f8" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_f75c0005-55e9-47ec-9a84-c6457da68612</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>Die Mustermappe muss mindestens Folgendes enthalten&#xA0;<reqif-xhtml:br/><reqif-xhtml:span style="text-decoration:underline;">Deckblatt:</reqif-xhtml:span><reqif-xhtml:br/><reqif-xhtml:br/></reqif-xhtml:p><reqif-xhtml:ul><reqif-xhtml:li style="margin-left:24px;">&#xDC;berschrift</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Teilebezeichnung</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Teilnummer Auftraggeber</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Teilnummer Auftragnehmer</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Mechanik-Stand (z. B. Geh&#xE4;use)</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Projektleitername des Auftragnehmers</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Unterlageninhaltsverzeichnis</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Stand des Lastenheftes</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Stand des Pflichtenheftes</reqif-xhtml:li></reqif-xhtml:ul><reqif-xhtml:p><reqif-xhtml:span style="text-decoration:underline;">Kurzbeschreibung:</reqif-xhtml:span><reqif-xhtml:br/><reqif-xhtml:br/></reqif-xhtml:p><reqif-xhtml:ul><reqif-xhtml:li style="margin-left:24px;">Alle &#xC4;nderungen gegen&#xFC;ber vorherigem Stand, die Notwendigkeit der &#xC4;nderung, die Auswirkung der &#xC4;nderung</reqif-xhtml:li></reqif-xhtml:ul><reqif-xhtml:p><reqif-xhtml:span style="text-decoration:underline;">Inhalt:</reqif-xhtml:span><reqif-xhtml:br/><reqif-xhtml:br/></reqif-xhtml:p><reqif-xhtml:ul><reqif-xhtml:li style="margin-left:24px;">Teilelebenslauf</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Pflichtenheft</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Mess- und Pr&#xFC;fberichte (inkl. Toleranzanalyse, Simulationsergebnisse)</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Pr&#xFC;fbericht zu Werkstoffanforderungen</reqif-xhtml:li><reqif-xhtml:li style="margin-left:24px;">Herstellungsverfahren</reqif-xhtml:li></reqif-xhtml:ul></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
						<ATTRIBUTE-VALUE-ENUMERATION>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-ENUMERATION-REF>_61dd5914-3a3d-4e22-9ece-95dc62c61fde</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
							</DEFINITION>
							<VALUES>
								<ENUM-VALUE-REF>_ded8839a-d6a6-4f3f-954d-b0ccc627fc45</ENUM-VALUE-REF>
							</VALUES>
						</ATTRIBUTE-VALUE-ENUMERATION>
						<ATTRIBUTE-VALUE-INTEGER THE-VALUE="19250555">
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-INTEGER-REF>_dd51195c-820f-4a8e-9dbd-9e4be23793cb</ATTRIBUTE-DEFINITION-INTEGER-REF>
							</DEFINITION>
						</ATTRIBUTE-VALUE-INTEGER>
						<ATTRIBUTE-VALUE-XHTML>
							<DEFINITION>
								<ATTRIBUTE-DEFINITION-XHTML-REF>_b988e6c6-e742-4101-8e95-8a2905a50c8e</ATTRIBUTE-DEFINITION-XHTML-REF>
							</DEFINITION>
							<THE-VALUE><reqif-xhtml:div><reqif-xhtml:p style="margin-left:24px;"/><reqif-xhtml:p>The sample documentation must include at least the following:&#xA0;<reqif-xhtml:br/><reqif-xhtml:span style="text-decoration:underline;">Cover sheet:</reqif-xhtml:span></reqif-xhtml:p><reqif-xhtml:p><reqif-xhtml:br/></reqif-xhtml:p><reqif-xhtml:ul><reqif-xhtml:li>Heading</reqif-xhtml:li><reqif-xhtml:li>Part designation</reqif-xhtml:li><reqif-xhtml:li>Purchaser&#039;s part number</reqif-xhtml:li><reqif-xhtml:li>Contractor&#039;s part number</reqif-xhtml:li><reqif-xhtml:li>Mechanical component version (e.g., housing)</reqif-xhtml:li><reqif-xhtml:li>Name of the contractor&#039;s project manager</reqif-xhtml:li><reqif-xhtml:li>Document table of contents</reqif-xhtml:li><reqif-xhtml:li>Performance Specification version</reqif-xhtml:li><reqif-xhtml:li>Product Development Specification version<reqif-xhtml:br/><reqif-xhtml:span style="text-decoration:underline;"/></reqif-xhtml:li></reqif-xhtml:ul><reqif-xhtml:p><reqif-xhtml:span style="text-decoration:underline;">Brief description:</reqif-xhtml:span><reqif-xhtml:br/><reqif-xhtml:br/></reqif-xhtml:p><reqif-xhtml:ul><reqif-xhtml:li>All changes compared to the previous version, the reason for the change, the impact of the change<reqif-xhtml:br/><reqif-xhtml:span style="text-decoration:underline;"/></reqif-xhtml:li></reqif-xhtml:ul><reqif-xhtml:p><reqif-xhtml:span style="text-decoration:underline;">Contents:</reqif-xhtml:span><reqif-xhtml:br/><reqif-xhtml:br/></reqif-xhtml:p><reqif-xhtml:ul><reqif-xhtml:li>Part history</reqif-xhtml:li><reqif-xhtml:li>Product Development Specification</reqif-xhtml:li><reqif-xhtml:li>Measurement and test reports (including tolerance stack-up analysis, simulation results)</reqif-xhtml:li><reqif-xhtml:li>Test report on the materials requirements</reqif-xhtml:li><reqif-xhtml:li>Manufacturing methods</reqif-xhtml:li></reqif-xhtml:ul></reqif-xhtml:div></THE-VALUE>
						</ATTRIBUTE-VALUE-XHTML>
					</VALUES>
				</SPEC-OBJECT>
				<SPEC-OBJECT IDENTIFIER="_0adccb31-371c-4943-a328-ab628a245966" LAST-CHANGE="2025-05-15T15:04:28">
					<TYPE>
						<SPEC-OBJECT-TYPE-REF>_6071edb2-6898-4ffb-931b-eb6f7075b7cd</SPEC-OBJECT-TYPE-REF>
					</TYPE>
					<VALUES>
						<ATTRIBUTE-VALUE-XHTML>
