        <SPEC-OBJECT IDENTIFIER="_d229ab85-8b23-43ea-bfa1-77679987657c" LAST-CHANGE="2025-05-15T15:04:28.000+02:00">
          <VALUES>
            <ATTRIBUTE-VALUE-XHTML>
