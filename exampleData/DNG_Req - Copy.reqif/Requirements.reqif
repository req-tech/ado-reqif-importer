					<rm:ATTRIBUTE-DEFINITION-XHTML-REF>_0b7b3a48-ae80-4042-b5e2-d7247cbed839</rm:ATTRIBUTE-DEFINITION-XHTML-REF>
					<rm:ATTRIBUTE-VALUE-XHTML><![CDATA[<div xmlns="http://www.w3.org/1999/xhtml"><p dir="ltr" style="margin-left: 40px; "><span style="font-size: 11pt; font-family: arial, helvetica, sans-serif; ">The system shall provide IR imagery with the minimum specified thermal sensitivity.</span></p></div>]]></rm:ATTRIBUTE-VALUE-XHTML>
				</rm:SPEC-OBJECT-EXTENSION>
				<rm:SPEC-OBJECT-EXTENSION>
					<SPEC-OBJECT-REF>_1bca2381-b7ec-4ac6-9d21-b83f51c0ff01</SPEC-OBJECT-REF>
