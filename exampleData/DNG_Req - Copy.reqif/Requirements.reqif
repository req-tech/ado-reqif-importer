					<rm:CORE-SPEC-OBJECT-REF>_7cb75497-7ff3-4fc7-b9f4-01d02b9a419a</rm:CORE-SPEC-OBJECT-REF>
					<rm:ATTRIBUTE-DEFINITION-XHTML-REF>_0b7b3a48-ae80-4042-b5e2-d7247cbed839</rm:ATTRIBUTE-DEFINITION-XHTML-REF>
					<rm:ATTRIBUTE-VALUE-XHTML><![CDATA[<div xmlns="http://www.w3.org/1999/xhtml"><p dir="ltr" style="margin-left: 40px; "><span style="font-size: 11pt; font-family: arial, helvetica, sans-serif; ">The system shall allow the operator to configure mission profiles through the GCS UI.</span></p></div>]]></rm:ATTRIBUTE-VALUE-XHTML>
				</rm:SPEC-OBJECT-EXTENSION>
				<rm:SPEC-OBJECT-EXTENSION>
					<SPEC-OBJECT-REF>_670fc195-09cf-47db-80e6-484b053ec1ef</SPEC-OBJECT-REF>
					<rm:HAS-SERVER-GENERATED-TITLE>true</rm:HAS-SERVER-GENERATED-TITLE>
