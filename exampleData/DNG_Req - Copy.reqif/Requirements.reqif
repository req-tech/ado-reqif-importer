					<rm:ATTRIBUTE-DEFINITION-XHTML-REF>_0b7b3a48-ae80-4042-b5e2-d7247cbed839</rm:ATTRIBUTE-DEFINITION-XHTML-REF>
					<rm:ATTRIBUTE-VALUE-XHTML><![CDATA[<div xmlns="http://www.w3.org/1999/xhtml"><p dir="ltr" style="margin-left: 40px; "><span style="font-size: 11pt; font-family: arial, helvetica, sans-serif; ">The system shall allow swapping of payload modules without specialized tools.</span></p></div>]]></rm:ATTRIBUTE-VALUE-XHTML>
				</rm:SPEC-OBJECT-EXTENSION>
				<rm:SPEC-OBJECT-EXTENSION>
					<SPEC-OBJECT-REF>_962f929b-f9c0-4bba-b7ac-aa2222fa06cd</SPEC-OBJECT-REF>
