					<rm:ATTRIBUTE-DEFINITION-XHTML-REF>_0b7b3a48-ae80-4042-b5e2-d7247cbed839</rm:ATTRIBUTE-DEFINITION-XHTML-REF>
					<rm:ATTRIBUTE-VALUE-XHTML><![CDATA[<div xmlns="http://www.w3.org/1999/xhtml"><p dir="ltr" style="margin-left: 40px; "><span style="font-size: 11pt; font-family: arial, helvetica, sans-serif; ">This document defines the functional, performance, safety, interoperability, and operational requirements for a tactical AI-powered unmanned aerial system (UAS) intended for reconnaissance, surveillance, target acquisition, and autonomous mission support in contested environments.</span></p></div>]]></rm:ATTRIBUTE-VALUE-XHTML>
				</rm:SPEC-OBJECT-EXTENSION>
				<rm:SPEC-OBJECT-EXTENSION>
					<SPEC-OBJECT-REF>_8a3c4f9c-1a51-4f8e-be5a-3c56ad2b95e2</SPEC-OBJECT-REF>
