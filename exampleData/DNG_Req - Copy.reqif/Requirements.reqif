					<rm:ATTRIBUTE-VALUE-XHTML><![CDATA[<div xmlns="http://www.w3.org/1999/xhtml"><p dir="ltr" style="margin-left: 40px; "><span style="font-size: 11pt; font-family: arial, helvetica, sans-serif; ">The system shall provide EO imagery with the minimum specified resolution.</span></p></div>]]></rm:ATTRIBUTE-VALUE-XHTML>
				</rm:SPEC-OBJECT-EXTENSION>
				<rm:SPEC-OBJECT-EXTENSION>
					<SPEC-OBJECT-REF>_1dba2921-4b7c-47c8-9305-8b970f0b730a</SPEC-OBJECT-REF>
